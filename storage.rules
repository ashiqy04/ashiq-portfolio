rules_version = '2';

// Deploy: Firebase Console → Storage → Rules tab → paste this → Publish
//
// Replace YOUR_ADMIN_EMAIL below with your dev Gmail — same one used in
// firestore.rules and for signing in on /admin/login.

service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == "ashiqy04@gmail.com"
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }
  }
}
